codex() {
    local cfg="$HOME/.codex/config.toml"
    local model_setting effort_setting
    model_setting=$(sed -n '/^[[:space:]]*\[/q; /^[[:space:]]*model[[:space:]]*=/p' "$cfg")
    effort_setting=$(sed -n '/^[[:space:]]*\[/q; /^[[:space:]]*model_reasoning_effort[[:space:]]*=/p' "$cfg")
    command codex --approve-for-me -c "$model_setting" -c "$effort_setting" "$@"
  }

