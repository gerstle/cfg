sdm-find() {
    terms=("$@")
    args=""
    for t in "${terms[@]}"; do
        args="${args} | grep -w --color=never ${t}"
    done
    cmd="sdm status ${args}"

    eval "${cmd}"
}

sdm-mysql() {
    datasource_status=$(sdm-find "$@" | sed -r 's/ {2,}/\t/g')

    results=$(echo "${datasource_status}" | wc -l | xargs)
    if [ "${results}" != "1" ]; then
        echo "More than one datasource found with '$@', please be more specific."
        echo "Matching datasources:"
        while IFS= read -r line; do
            source=$(echo "${line}" | cut -f2)
            echo "  ${source}"
        done <<< "${datasource_status}"
        return
    fi

    datasource=$(echo "${datasource_status}" | cut -f2)
    connected=$(echo "${datasource_status}" | cut -f3)
    address=$(echo "${datasource_status}" | cut -f4)
    type=$(echo "${datasource_status}" | cut -f5)

    echo "${datasource}:"
    echo "  connected: ${connected}"
    echo "  address: ${address}"
    echo "  type: ${type}"

    if [ "${type}" != "mysql" ]; then
        echo "not a mysql type!"
        return
    fi

    if [ "${connected}" = "not connected" ]; then
        printf "connecting... "
        sdm connect ${datasource}
        if [ "$?" != "0" ]; then
            echo "connection failed!"
            return
        fi
    fi

    host=$(echo "${address}" | cut -d ":" -f1)
    port=$(echo "${address}" | cut -d ":" -f2)
    mysql -h "${host}" -P "${port}" -u ronin -p
    sdm disconnect "${datasource}"
}

sdm-close() {
    sources=$(sdm status)
    while IFS= read -r line; do
        data=$(echo "${line}" | sed -r 's/ {2,}/\t/g')
        source=$(echo "${data}" | cut -f2)
        connected=$(echo "${data}" | cut -f3)
        
        if [ "${connected}" = 'connected' ]; then
            printf "%s: %s --> " "${source}" "${connected}"
            sdm disconnect "${source}"
        fi
    done <<< "$sources"
    echo "done."
}

# ------------------------------------------------------------------------------
# oracle-sre
# ------------------------------------------------------------------------------
# alias scm-ssh-add='SSH_AUTH_SOCK=~/.ssh/scm-agent.sock ssh-add'
alias oa='oci session refresh || oci-auth.sh'
alias or='oci session refresh'
alias sa='scm-auth.sh'
alias cells='cat ~/.local/cells.yaml| yq'
resolve_devops_url() {
    if [[ -z "$1" ]]; then
        echo "usage: resolve_devops_url <devops-short-url-or-id>" >&2
        return 2
    fi

    local id token
    id="${1##*/}"
    id="${id%%\?*}"

    token="$(ssh operator-access-token.svc.ad1.r2 generate --mode jwt)" || return

    command curl --silent --show-error --fail \
        --header "Authorization: Bearer ${token}" \
        "https://devops.oci.oraclecorp.com/api/ui-service/v1/saved-queries/${id}" |
        jq --exit-status --raw-output '.originalQuery'
}
alias update-ssh-config='pushd ${HOME}/.ssh; for it in oda-configs ossh_configs ssh_configs; do; (cd -- "$it" && git pull); done; popd'

# ------------------------------------------------------------------------------
# fzf helpers
# ------------------------------------------------------------------------------
ef() {
    local file
    file=$(FZF_DEFAULT_COMMAND="${FZF_DEFAULT_COMMAND:-fd --type f --strip-cwd-prefix}" fzf --preview 'bat --style=numbers --color=always --line-range :200 {}') || return

    ${EDITOR:-vim} -- "$file"
}

cdf() {
    local dir
    dir=$(FZF_DEFAULT_COMMAND="${FZF_ALT_C_COMMAND:-fd --type d --strip-cwd-prefix}" fzf --preview 'ls -la {}') || return

    cd -- "$dir"
}

_fzf_any_dir() {
    local -a roots existing_roots
    local root

    if [ "${#FZF_ANY_DIR_ROOTS[@]}" -gt 0 ]; then
        roots=("${FZF_ANY_DIR_ROOTS[@]}")
    else
        roots=("$HOME/src" "$HOME/.config" "$HOME/.local")
    fi

    for root in "${roots[@]}"; do
        [ -d "$root" ] && existing_roots+=("$root")
    done

    if [ "${#existing_roots[@]}" -eq 0 ]; then
        echo "no FZF_ANY_DIR_ROOTS directories found" >&2
        return 1
    fi

    {
        printf "%s\n" "${existing_roots[@]}"
        fd --type d --hidden --exclude .git --exclude Library --exclude node_modules --exclude .terraform --exclude target --exclude build --exclude dist . "${existing_roots[@]}"
    } | awk '!seen[$0]++' | fzf --preview 'ls -la {}'
}

cda() {
    local dir
    dir=$(_fzf_any_dir) || return

    cd -- "$dir"
}

runf() {
    local file
    file=$(FZF_DEFAULT_COMMAND="${FZF_DEFAULT_COMMAND:-fd --type f --strip-cwd-prefix}" fzf --preview 'bat --style=numbers --color=always --line-range :200 {}') || return

    "$@" -- "$file"
}

_run_in_dir() {
    local dir cmd

    dir=$1
    cmd=$2
    shift 2

    case "$cmd" in
        codex)
            "$cmd" -C "$dir" "$@"
            ;;
        git|make)
            "$cmd" -C "$dir" "$@"
            ;;
        *)
            "$cmd" "$@" -- "$dir"
            ;;
    esac
}

rundir() {
    if [ "$#" -eq 0 ]; then
        echo "usage: rundir <command> [args...]" >&2
        return 2
    fi

    local dir cmd
    dir=$(FZF_DEFAULT_COMMAND="${FZF_ALT_C_COMMAND:-fd --type d --strip-cwd-prefix}" fzf --preview 'ls -la {}') || return

    cmd=$1
    shift

    _run_in_dir "$dir" "$cmd" "$@"
}

rundira() {
    if [ "$#" -eq 0 ]; then
        echo "usage: rundira <command> [args...]" >&2
        return 2
    fi

    local dir cmd
    dir=$(_fzf_any_dir) || return

    cmd=$1
    shift

    _run_in_dir "$dir" "$cmd" "$@"
}
